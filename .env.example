# Private AI — Environment Configuration
# Copy this file to .env and edit as needed.
# .env values are overridden by .private_ai/config.json

# Ollama server URL
# Default: http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434

# Primary model name (must be pulled in Ollama)
# Default: deepseek-coder-fix
MODEL_NAME=deepseek-coder-fix

# Fallback model if primary fails (optional)
# Leave empty for no fallback
FALLBACK_MODEL=

# Seconds to wait for user approval before auto-denying
# Default: 60
APPROVAL_TIMEOUT_SECONDS=60

# Enable debug mode (shows raw LLM responses)
# Values: true/false/1/0/yes/no
# Default: false
DEBUG_MODE=false

# Comma-separated list of enabled tools
# Leave empty to enable all tools
# Example: read_file,write_file,git_operation
ENABLED_TOOLS=

# Context window size for Ollama
# Lower = less RAM usage, Higher = more context
# Default: 4096
CONTEXT_SIZE=8192